{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "title": "loomwatch values",
  "description": "Constrains the fields where a wrong value produces a deployment that comes up and then quietly fails to do its job. Everything else is left open on purpose: over-specifying a schema turns every new upstream option into a chart release.",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Single writer against a SQLite file on a ReadWriteOnce volume; a second replica cannot attach it."
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "pollInterval": {
      "type": "integer",
      "minimum": 10,
      "description": "Seconds between provider polls. Provider quota APIs are themselves rate limited, so very short intervals buy nothing."
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "databasePath": {
      "type": "string",
      "minLength": 1
    },
    "resourcesPreset": {
      "type": "string",
      "enum": ["none", "nano", "micro", "small"]
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Recreate", "RollingUpdate"]
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Full digest including the sha256: prefix. When set it replaces the tag entirely."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "adminPassword": { "type": "string" },
        "metricsToken": { "type": "string" },
            "accounts": {
              "type": "array",
              "description": "Provider subscriptions declared in configuration. The credential is never written here: apiKeyEnv names the environment variable holding it, so the list can live in git while the secret stays where the deployment already keeps secrets.",
              "items": {
                "type": "object",
                "required": ["provider", "name", "apiKeyEnv"],
                "additionalProperties": false,
                "properties": {
                  "provider": { "type": "string", "enum": ["zai", "minimax"] },
                  "name": { "type": "string", "minLength": 1, "pattern": "^[^\\s\"]+$" },
                  "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "baseUrl": { "type": "string", "pattern": "^https?://[^\\s\"]+$" }
                }
              }
            },
        "existingSecret": { "type": "string" },
        "providers": {
          "type": "object",
          "description": "Environment variable name to value, e.g. MINIMAX_API_KEY. Free-form because the supported provider set changes between upstream releases.",
          "additionalProperties": { "type": "string" },
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "secretKeys": {
          "type": "object",
          "properties": {
            "adminPasswordKey": { "type": "string", "minLength": 1 },
            "metricsTokenKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "ports": {
          "type": "object",
          "properties": {
            "http": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|K|Ei|Pi|Ti|Gi|Mi|Ki)?$" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "highThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
            "criticalThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
            "providers": { "type": "string", "minLength": 1 },
            "ignoredQuotaTypes": {
              "type": "string",
              "description": "PromQL label matchers are fully anchored, so a bare `video` does NOT exclude `weekly_video`."
            },
            "nonAccountProviders": { "type": "string", "minLength": 1 },
            "runbookUrlBase": { "type": "string", "pattern": "^https?://[^\\s\"]+$" },
            "teams": {
              "type": "array",
              "description": "Maps a provider account to the team that owns it. accountId is a string and must be quoted: YAML reads a bare 1000000 as a number, which Helm renders as 1e+06 and which would map a phantom account while leaving the real one unassigned. team is restricted to a positive character class rather than an exclusion list, because an exclusion list passes newlines and control characters that break rendering, and passes zero-width characters that produce two teams nobody can tell apart.",
              "items": {
                "type": "object",
                "required": ["provider", "accountId", "team"],
                "additionalProperties": false,
                "properties": {
                  "provider": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                  "accountId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                  "team": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,62}$" }
                }
              }
            },
            "burn": {
              "type": "object",
              "properties": {
                "trendWindow": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m|h|d|w)$"
                },
                "shortTrendWindow": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m|h|d|w)$"
                },
                "shortWindowMaxSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Quota windows this long or shorter are measured over shortTrendWindow instead of trendWindow."
                },
                "maxHorizonSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Windows resetting further away than this are not predicted: the extrapolation would be noise rather than evidence."
                }
              }
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^$|^[0-9]+(ms|s|m|h)$" },
            "scrapeTimeout": { "type": "string", "pattern": "^$|^[0-9]+(ms|s|m|h)$" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "pathType": {
          "type": "string",
          "enum": ["ImplementationSpecific", "Prefix", "Exact"]
        }
      }
    },
    "podAntiAffinityPreset": { "type": "string", "enum": ["", "soft", "hard"] },
    "podAffinityPreset": { "type": "string", "enum": ["", "soft", "hard"] },
    "nodeAffinityPreset": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["", "soft", "hard"] }
      }
    }
  }
}
